\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Scientific workflow. Stage\nobreakspace  {}1a estimates the relative JCAPS calibration from within-binary differences. Conditional on those fixed estimates, Stage\nobreakspace  {}1b returns a posterior probability mass over each shared system metallicity. Stage\nobreakspace  {}2 propagates this uncertainty into the dynamical MLR fit but does not update either Stage\nobreakspace  {}1 module. This one-way flow implements the modular cut.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:workflow}{{1}{2}{Scientific workflow. Stage~1a estimates the relative JCAPS calibration from within-binary differences. Conditional on those fixed estimates, Stage~1b returns a posterior probability mass over each shared system metallicity. Stage~2 propagates this uncertainty into the dynamical MLR fit but does not update either Stage~1 module. This one-way flow implements the modular cut}{figure.1}{}}
\newlabel{fig:workflow@cref}{{[figure][1][]1}{[1][1][]2}}
