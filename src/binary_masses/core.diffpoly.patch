+class DifferencePolyMassAbsgModel(PolyMassAbsgModel):
+    """
+    Polynomial model for the **difference** relative to an isochrone:
+        log10 M_dyn(M_G) = log10 M_iso(M_G) + sum_i c_i * x^i,
+    where x is the rescaled M_G in [-1, 1] as in PolyMassAbsgModel.
+    """
+    def __init__(self, order=3, absg_min=-1.0, absg_max=15.0, pivot=None,
+                 rescale=True, deriv_penalty=False, deriv_penalty_strength=10.0,
+                 mass_min=0.03, mass_max=2.0, log10_mass_floor=-2.0,
+                 isochrone_model=None):
+        if isochrone_model is None:
+            raise ValueError("DifferencePolyMassAbsgModel requires an `isochrone_model` (IsochroneMassModel).")
+        super().__init__(order=order, absg_min=absg_min, absg_max=absg_max, pivot=pivot,
+                         rescale=rescale, deriv_penalty=deriv_penalty,
+                         deriv_penalty_strength=deriv_penalty_strength,
+                         mass_min=mass_min, mass_max=mass_max, log10_mass_floor=log10_mass_floor)
+        self.iso_model = isochrone_model
+
+    # override: return 10**(log10 m_iso + poly)
+    def mass_from_absg(self, absg, params):
+        import numpy as _np
+        absg = _np.asarray(absg)
+        x = self._x_from_absg(absg)
+        log10_delta = self._poly_eval(x, params)  # difference term
+        m_iso = self.iso_model.mass_from_absg(absg)
+        mass = _np.power(10.0, _np.log10(_np.maximum(m_iso, self.mass_min)) + log10_delta)
+        mass = _np.clip(mass, self.mass_min, self.mass_max)
+        return mass
+
+    def mass_from_absg_jax(self, absg, params):
+        import jax.numpy as _jnp
+        absg = _jnp.asarray(absg)
+        x = self._x_from_absg_jax(absg)
+        log10_delta = self._poly_eval_jax(x, params)
+        m_iso = self.iso_model.mass_from_absg_jax(absg)
+        safe_iso = _jnp.maximum(m_iso, self.mass_min)
+        mass = _jnp.power(10.0, _jnp.log10(safe_iso) + log10_delta)
+        mass = _jnp.clip(mass, self.mass_min, self.mass_max)
+        return mass
+
