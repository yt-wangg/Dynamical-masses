+class IsochroneMassModel:
+    """
+    Lightweight wrapper providing m_iso(M_G). Accepts either
+    (1) a callable f(M_G)->mass, or
+    (2) monotonic sample arrays (absg_grid, mass_grid) for interpolation.
+    Provides NumPy and JAX versions.
+    """
+    def __init__(self, absg_min=-1.0, absg_max=15.0, func=None,
+                 absg_grid=None, mass_grid=None, mass_min=0.01):
+        import numpy as _np
+        import jax.numpy as _jnp
+        self.absg_min = absg_min
+        self.absg_max = absg_max
+        self.mass_min = mass_min
+        if func is not None and (absg_grid is not None or mass_grid is not None):
+            raise ValueError("Provide either func or (absg_grid, mass_grid), not both.")
+        self._func = func
+        if func is None:
+            if absg_grid is None or mass_grid is None:
+                raise ValueError("Need both absg_grid and mass_grid when func is None.")
+            self.absg_grid_np = _np.asarray(absg_grid)
+            self.mass_grid_np = _np.asarray(mass_grid)
+            # simple monotonic guard
+            order = _np.argsort(self.absg_grid_np)
+            self.absg_grid_np = self.absg_grid_np[order]
+            self.mass_grid_np = self.mass_grid_np[order]
+            # jax copies
+            self.absg_grid = _jnp.asarray(self.absg_grid_np)
+            self.mass_grid = _jnp.asarray(self.mass_grid_np)
+        else:
+            self.absg_grid_np = None
+            self.mass_grid_np = None
+            self.absg_grid = None
+            self.mass_grid = None
+
+    def mass_from_absg(self, absg):
+        import numpy as _np
+        absg = _np.asarray(absg)
+        if self._func is not None:
+            m = self._func(absg)
+        else:
+            m = _np.interp(absg, self.absg_grid_np, self.mass_grid_np, left=self.mass_grid_np[0], right=self.mass_grid_np[-1])
+        m = _np.where(m > 0.0, m, self.mass_min)
+        return m
+
+    def mass_from_absg_jax(self, absg):
+        import jax.numpy as _jnp
+        absg = _jnp.asarray(absg)
+        if self._func is not None:
+            m = self._func(absg)
+        else:
+            m = _jnp.interp(absg, self.absg_grid, self.mass_grid)
+        m = _jnp.where(m > 0.0, m, self.mass_min)
+        return m
